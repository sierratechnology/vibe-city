{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ws.js": {
      "maxDuration": 300
    }
  },
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/daily-save",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wiki.vibe-city.net"
        }
      ],
      "destination": "/wiki/index.html"
    }
  ]
}
